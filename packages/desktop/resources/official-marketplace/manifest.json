          "name": "luochang212",
          "url": "https://github.com/luochang212"
        },
        "examplePrompts": [
          "Run an experiment loop to make this benchmark faster without breaking the checks",
          "Which approaches were tried so far, and why were the discarded ones rejected?"
        ],
        "examplePrompts_i18n": {
