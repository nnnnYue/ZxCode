{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/renderer",
    "rootDir": "src/renderer",
    "lib": ["es2025", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["src/renderer"],
  // fork：src/renderer 下的 *.test.ts 属已退役 App 业务单测的孤儿残留（vitest "unit" 工程
  // include 不覆盖该目录，无任何 runner 执行），依赖 node 内建类型会污染 renderer DOM 程序，
  // 从 tsc 程序排除；文件保留，若日后恢复需配 vitest 工程 + 独立 tsconfig。
  "exclude": ["src/renderer/**/*.test.ts"],
  // renderer 直接 import 了 shared；把它补进 references，避免 renderer 单独检查时再走源码回退路径。
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../client" }
  ]
}
