{
  "name": "ios-simulator",
  "version": "0.1.0",
  "description": "Provides iOS development workflows and simulator automation for ZCode.",
  "author": {
    "name": "Z.ai"
  },
  "license": "MIT",
  "skills": "skills",
  "commands": "commands",
  "mcpServers": {
    "ios-simulator": {
      "command": "/Applications/ZCode.app/Contents/Frameworks/ZCode Helper.app/Contents/MacOS/ZCode Helper",
      "args": [
        "/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs",
        "__zcode-plugin-host",
        "/Users/edward/.zcode/cli/plugins/cache/zcode-plugins-official/ios-simulator/0.1.0/dist/mcp/server.js"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "IOS_SIM_PACKAGE_ROOT": "${ZCODE_PLUGIN_ROOT}",
        "IOS_SIM_PLUGIN_DATA": "${ZCODE_PLUGIN_DATA}",
        "IOS_SIM_DEFAULT_DEVICE": "${user_config.default_device}",
        "IOS_SIM_UI_BACKEND": "${user_config.ui_backend}",
        "ELECTRON_RUN_AS_NODE": "1",
        "ZCODE_PLUGIN_ID": "ios-simulator@zcode-plugins-official"
      }
    }
  },
  "userConfig": {
    "default_device": {
      "type": "string",
      "default": "iPhone 16",
      "description": "Preferred simulator device name."
    },
    "ui_backend": {
      "type": "string",
      "default": "auto",
      "description": "UI interaction backend: auto, idb, xcodebuildmcp, or none."
    }
  }
}
